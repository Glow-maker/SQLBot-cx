# Table: dmgt_category, 目录扩展表
[
(name:VARCHAR, 目录名称),
(en_name:VARCHAR, 英文名称),
(no:VARCHAR, 目录编码, 非空),
(level:TINYINT, 层级, 非空),
(status:VARCHAR, 状态: active/in_active, 默认值: enabled),
(mount_status:VARCHAR, 挂载状态: mounted/un_mounted, 默认值: un_mounted),
(remark:TEXT, 描述),
(data_source_level:VARCHAR, 数据级别,l4才有,dws/ads),
(view_times:BIGINT, 查看次数，l4才有, 默认值: 0),
(download_times:BIGINT, 下载次数，l4才有, 默认值: 0),
(creator:BIGINT, 创建人),
(updater:BIGINT, 修改人),
(tenant_id:BIGINT, 租户),
(deleted:CHAR, 是否删除, 非空, 默认值: 0),
(create_time:DATETIME, 创建时间),
(update_time:DATETIME, 更新时间),
(table_type:VARCHAR, 表类型：master/slave),
(sort:SMALLINT, 目录顺序, 默认值: 0),
(sub_level:VARCHAR, 子层级：1,2,3等),
(approval_status:VARCHAR, 审批状态, 非空, 默认值: draft)
]

